*> Corrigé TP2.1 : calculatrice
IDENTIFICATION DIVISION.
PROGRAM-ID. TP21.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-SAISIE    PIC X(15).
01 WS-N1        PIC S9(5)V99.
01 WS-N2        PIC S9(5)V99.
01 WS-OP        PIC X.
01 WS-RES       PIC S9(9)V99.
01 WS-RES-ED    PIC -(9)9.99.
01 WS-ERREUR    PIC X VALUE "N".
   88 ERREUR-OUI   VALUE "O".
01 WS-SUITE     PIC X VALUE "O".
   88 CONTINUER    VALUE "O" "o".

PROCEDURE DIVISION.
0000-PRINCIPAL.
    PERFORM UNTIL NOT CONTINUER
        PERFORM 1000-SAISIE
        PERFORM 2000-CALCUL
        PERFORM 3000-AFFICHAGE
        DISPLAY "Autre calcul (O/N) ? " WITH NO ADVANCING
        ACCEPT WS-SUITE
    END-PERFORM
    DISPLAY "Au revoir"
    STOP RUN.

1000-SAISIE.
    DISPLAY "Premier nombre ? " WITH NO ADVANCING
    ACCEPT WS-SAISIE
    COMPUTE WS-N1 = FUNCTION NUMVAL(WS-SAISIE)
    DISPLAY "Operateur (+ - * /) ? " WITH NO ADVANCING
    ACCEPT WS-OP
    DISPLAY "Second nombre ? " WITH NO ADVANCING
    ACCEPT WS-SAISIE
    COMPUTE WS-N2 = FUNCTION NUMVAL(WS-SAISIE).

2000-CALCUL.
    MOVE "N" TO WS-ERREUR
    MOVE 0 TO WS-RES
    EVALUATE WS-OP
        WHEN "+"
            ADD WS-N1 WS-N2 GIVING WS-RES
        WHEN "-"
            SUBTRACT WS-N2 FROM WS-N1 GIVING WS-RES
        WHEN "*"
            MULTIPLY WS-N1 BY WS-N2 GIVING WS-RES
        WHEN "/"
            DIVIDE WS-N1 BY WS-N2 GIVING WS-RES
                ON SIZE ERROR
                    SET ERREUR-OUI TO TRUE
            END-DIVIDE
        WHEN OTHER
            SET ERREUR-OUI TO TRUE
    END-EVALUATE.

3000-AFFICHAGE.
    IF ERREUR-OUI
        DISPLAY "Erreur : operation impossible (division par zero ou operateur inconnu)"
    ELSE
        MOVE WS-RES TO WS-RES-ED
        DISPLAY "Resultat = " FUNCTION TRIM(WS-RES-ED)
    END-IF.
