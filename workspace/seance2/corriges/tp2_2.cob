*> Corrigé TP2.2 : boucles
IDENTIFICATION DIVISION.
PROGRAM-ID. TP22.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-N         PIC 99.
01 WS-I         PIC 99.
01 WS-PRODUIT   PIC 9(4).
01 WS-SOMME     PIC 9(6)  VALUE 0.
01 WS-FACT      PIC 9(10) VALUE 1.
01 WS-ERREUR    PIC X     VALUE "N".
   88 DEPASSEMENT        VALUE "O".

PROCEDURE DIVISION.
0000-PRINCIPAL.
    DISPLAY "Un nombre N (1..30) ? " WITH NO ADVANCING
    ACCEPT WS-N
    PERFORM 1000-TABLE
    PERFORM 2000-SOMME
    PERFORM 3000-FIZZBUZZ
    PERFORM 4000-FACTORIELLE
    STOP RUN.

1000-TABLE.
    DISPLAY "--- Table de " WS-N " ---"
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
        COMPUTE WS-PRODUIT = WS-N * WS-I
        DISPLAY WS-N " x " WS-I " = " WS-PRODUIT
    END-PERFORM.

2000-SOMME.
    MOVE 0 TO WS-SOMME
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N
        ADD WS-I TO WS-SOMME
    END-PERFORM
    DISPLAY "Somme de 1 a " WS-N " = " WS-SOMME.

3000-FIZZBUZZ.
    DISPLAY "--- FizzBuzz 1..30 ---"
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 30
        EVALUATE TRUE
            WHEN FUNCTION MOD(WS-I, 15) = 0
                DISPLAY "FizzBuzz"
            WHEN FUNCTION MOD(WS-I, 3) = 0
                DISPLAY "Fizz"
            WHEN FUNCTION MOD(WS-I, 5) = 0
                DISPLAY "Buzz"
            WHEN OTHER
                DISPLAY WS-I
        END-EVALUATE
    END-PERFORM.

4000-FACTORIELLE.
    MOVE 1 TO WS-FACT
    MOVE "N" TO WS-ERREUR
    PERFORM VARYING WS-I FROM 2 BY 1
            UNTIL WS-I > WS-N OR DEPASSEMENT
        MULTIPLY WS-I BY WS-FACT
            ON SIZE ERROR
                SET DEPASSEMENT TO TRUE
                DISPLAY "Depassement a partir de N = " WS-I
        END-MULTIPLY
    END-PERFORM
    IF NOT DEPASSEMENT
        DISPLAY WS-N "! = " WS-FACT
    END-IF.
