*> Corrigé TP2.3 : facture avec remise par tranches et TVA
IDENTIFICATION DIVISION.
PROGRAM-ID. TP23.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-SAISIE      PIC X(15).
01 WS-NB-ART      PIC 99.
01 WS-I           PIC 99.
01 WS-QTE         PIC 9(4).
01 WS-PRIX        PIC 9(5)V99.
01 WS-LIGNE       PIC 9(7)V99.
01 WS-TOTAL-HT    PIC 9(8)V99  VALUE 0.
01 WS-TAUX-REM    PIC 99       VALUE 0.
01 WS-REMISE      PIC 9(8)V99.
01 WS-NET-HT      PIC 9(8)V99.
01 WS-TVA         PIC 9(8)V99.
01 WS-TTC         PIC 9(8)V99.
01 WS-ED          PIC Z,ZZZ,ZZ9.99.

PROCEDURE DIVISION.
0000-PRINCIPAL.
    PERFORM 1000-SAISIE-ARTICLES
    PERFORM 2000-CALCULS
    PERFORM 3000-FACTURE
    STOP RUN.

1000-SAISIE-ARTICLES.
    DISPLAY "Nombre d'articles ? " WITH NO ADVANCING
    ACCEPT WS-NB-ART
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-NB-ART
        DISPLAY "Article " WS-I " - quantite ? " WITH NO ADVANCING
        ACCEPT WS-SAISIE
        COMPUTE WS-QTE = FUNCTION NUMVAL(WS-SAISIE)
        DISPLAY "Article " WS-I " - prix unitaire ? " WITH NO ADVANCING
        ACCEPT WS-SAISIE
        COMPUTE WS-PRIX = FUNCTION NUMVAL(WS-SAISIE)
        COMPUTE WS-LIGNE = WS-QTE * WS-PRIX
        ADD WS-LIGNE TO WS-TOTAL-HT
    END-PERFORM.

2000-CALCULS.
    EVALUATE TRUE
        WHEN WS-TOTAL-HT >= 1000   MOVE 15 TO WS-TAUX-REM
        WHEN WS-TOTAL-HT >= 500    MOVE 10 TO WS-TAUX-REM
        WHEN WS-TOTAL-HT >= 100    MOVE 5  TO WS-TAUX-REM
        WHEN OTHER                 MOVE 0  TO WS-TAUX-REM
    END-EVALUATE
    COMPUTE WS-REMISE ROUNDED = WS-TOTAL-HT * WS-TAUX-REM / 100
    COMPUTE WS-NET-HT = WS-TOTAL-HT - WS-REMISE
    COMPUTE WS-TVA ROUNDED = WS-NET-HT * 20 / 100
    COMPUTE WS-TTC = WS-NET-HT + WS-TVA.

3000-FACTURE.
    DISPLAY " "
    DISPLAY "============== FACTURE =============="
    MOVE WS-TOTAL-HT TO WS-ED
    DISPLAY "Total HT          : " WS-ED
    MOVE WS-REMISE TO WS-ED
    DISPLAY "Remise (" WS-TAUX-REM " %)     : " WS-ED
    MOVE WS-NET-HT TO WS-ED
    DISPLAY "Net HT            : " WS-ED
    MOVE WS-TVA TO WS-ED
    DISPLAY "TVA 20 %          : " WS-ED
    MOVE WS-TTC TO WS-ED
    DISPLAY "TOTAL TTC         : " WS-ED
    DISPLAY "=====================================".
