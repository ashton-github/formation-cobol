*> Corrigé TP4.1 : rapport de stock (écran + fichier)
IDENTIFICATION DIVISION.
PROGRAM-ID. TP41.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT F-PRODUITS ASSIGN TO "seance4/data/produits.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FS.
    SELECT F-RAPPORT ASSIGN TO "seance4/out/rapport_stock.txt"
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD F-PRODUITS.
01 ENR-PRODUIT.
   05 PRD-CODE      PIC X(5).
   05 PRD-LIBELLE   PIC X(20).
   05 PRD-PRIX      PIC 9(4)V99.
   05 PRD-STOCK     PIC 9(4).
FD F-RAPPORT.
01 ENR-RAPPORT      PIC X(80).

WORKING-STORAGE SECTION.
01 WS-FS            PIC XX.
   88 FS-OK                VALUE "00".
   88 FS-FIN               VALUE "10".
01 WS-NB            PIC 999     VALUE 0.
01 WS-NB-COMMANDE   PIC 999     VALUE 0.
01 WS-VALEUR        PIC 9(8)V99.
01 WS-TOTAL         PIC 9(9)V99 VALUE 0.
01 WS-LIGNE.
   05 L-CODE        PIC X(5).
   05 FILLER        PIC X      VALUE SPACE.
   05 L-LIBELLE     PIC X(20).
   05 FILLER        PIC X      VALUE SPACE.
   05 L-PRIX        PIC ZZZ9.99.
   05 FILLER        PIC X      VALUE SPACE.
   05 L-STOCK       PIC ZZZ9.
   05 FILLER        PIC X      VALUE SPACE.
   05 L-VALEUR      PIC Z,ZZZ,ZZ9.99.
   05 FILLER        PIC X      VALUE SPACE.
   05 L-ALERTE      PIC X(11).
01 WS-ED-TOTAL      PIC Z,ZZZ,ZZ9.99.

PROCEDURE DIVISION.
0000-PRINCIPAL.
    OPEN INPUT F-PRODUITS
    IF NOT FS-OK
        DISPLAY "Erreur ouverture produits, statut " WS-FS
        STOP RUN
    END-IF
    OPEN OUTPUT F-RAPPORT

    MOVE "CODE  LIBELLE                PRIX STOCK       VALEUR" TO ENR-RAPPORT
    PERFORM 8000-ECRIRE-LIGNE-BRUTE

    READ F-PRODUITS
        AT END CONTINUE
    END-READ
    PERFORM UNTIL FS-FIN
        PERFORM 1000-TRAITER
        READ F-PRODUITS
            AT END CONTINUE
        END-READ
    END-PERFORM

    MOVE WS-TOTAL TO WS-ED-TOTAL
    MOVE SPACES TO ENR-RAPPORT
    STRING "Produits : " WS-NB "   A commander : " WS-NB-COMMANDE
           "   Valeur totale : " WS-ED-TOTAL
           DELIMITED BY SIZE INTO ENR-RAPPORT
    END-STRING
    PERFORM 8000-ECRIRE-LIGNE-BRUTE

    CLOSE F-PRODUITS F-RAPPORT
    STOP RUN.

1000-TRAITER.
    ADD 1 TO WS-NB
    COMPUTE WS-VALEUR = PRD-PRIX * PRD-STOCK
    ADD WS-VALEUR TO WS-TOTAL
    MOVE PRD-CODE    TO L-CODE
    MOVE PRD-LIBELLE TO L-LIBELLE
    MOVE PRD-PRIX    TO L-PRIX
    MOVE PRD-STOCK   TO L-STOCK
    MOVE WS-VALEUR   TO L-VALEUR
    IF PRD-STOCK < 10
        MOVE "A COMMANDER" TO L-ALERTE
        ADD 1 TO WS-NB-COMMANDE
    ELSE
        MOVE SPACES TO L-ALERTE
    END-IF
    MOVE WS-LIGNE TO ENR-RAPPORT
    PERFORM 8000-ECRIRE-LIGNE-BRUTE.

*> Écrit ENR-RAPPORT dans le fichier ET à l'écran
8000-ECRIRE-LIGNE-BRUTE.
    DISPLAY FUNCTION TRIM(ENR-RAPPORT TRAILING)
    WRITE ENR-RAPPORT.
