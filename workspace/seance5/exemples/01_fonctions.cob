*> ---------------------------------------------------------------
*> Exemple 5.1 : fonctions intrinsèques utiles (dates, maths, texte)
*> ---------------------------------------------------------------
IDENTIFICATION DIVISION.
PROGRAM-ID. FONCT01.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-DATE-HEURE.
   05 WS-ANNEE      PIC 9(4).
   05 WS-MOIS       PIC 99.
   05 WS-JOUR       PIC 99.
   05 WS-HEURE      PIC 99.
   05 WS-MINUTE     PIC 99.
   05 WS-SECONDE    PIC 99.
   05 WS-CENTIEME   PIC 99.
   05 WS-DECALAGE   PIC X(5).
01 WS-AUJOURDHUI    PIC 9(8).
01 WS-NAISSANCE     PIC 9(8) VALUE 19900714.
01 WS-NOEL          PIC 9(8) VALUE 20261225.
01 WS-JOURS-VECUS   PIC 9(6).
01 WS-JOURS-AVANT   PIC 9(4).
01 WS-DATE-PLUS-30  PIC 9(8).
01 WS-JOUR-SEMAINE  PIC 9.
01 WS-RACINE        PIC 9(3)V99.
01 WS-ED            PIC Z(5)9.99.

PROCEDURE DIVISION.
    MOVE FUNCTION CURRENT-DATE TO WS-DATE-HEURE
    MOVE WS-DATE-HEURE(1:8) TO WS-AUJOURDHUI
    DISPLAY "Aujourd'hui : " WS-JOUR "/" WS-MOIS "/" WS-ANNEE
            " a " WS-HEURE ":" WS-MINUTE ":" WS-SECONDE

    COMPUTE WS-JOURS-VECUS =
        FUNCTION INTEGER-OF-DATE(WS-AUJOURDHUI)
      - FUNCTION INTEGER-OF-DATE(WS-NAISSANCE)
    DISPLAY "Jours depuis le 14/07/1990 : " WS-JOURS-VECUS

    COMPUTE WS-JOURS-AVANT =
        FUNCTION INTEGER-OF-DATE(WS-NOEL)
      - FUNCTION INTEGER-OF-DATE(WS-AUJOURDHUI)
    DISPLAY "Jours avant le 25/12/2026  : " WS-JOURS-AVANT

    COMPUTE WS-DATE-PLUS-30 = FUNCTION DATE-OF-INTEGER(
        FUNCTION INTEGER-OF-DATE(WS-AUJOURDHUI) + 30)
    DISPLAY "Date dans 30 jours (AAAAMMJJ) : " WS-DATE-PLUS-30

    COMPUTE WS-JOUR-SEMAINE =
        FUNCTION MOD(FUNCTION INTEGER-OF-DATE(WS-NOEL), 7)
    DISPLAY "Jour de la semaine de Noel (0=dimanche) : " WS-JOUR-SEMAINE

    COMPUTE WS-RACINE = FUNCTION SQRT(2)
    MOVE WS-RACINE TO WS-ED
    DISPLAY "Racine de 2 : " WS-ED
    DISPLAY "MAX(3, 9, 5)  : " FUNCTION MAX(3, 9, 5)
    DISPLAY "MIN(3, 9, 5)  : " FUNCTION MIN(3, 9, 5)
    DISPLAY "ABS(-12)      : " FUNCTION ABS(-12)
    DISPLAY "NUMVAL(' 12.5 ')    : " FUNCTION NUMVAL(" 12.5 ")
    STOP RUN.
